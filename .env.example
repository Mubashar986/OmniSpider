# === Database Configuration ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=lead_gen_db

# === Redis Configuration ===
REDIS_URL=rediss://default:your_upstash_redis_token@your-redis-instance.upstash.io:6379

# === Scraper Pipeline ===
SCRAPE_COOLDOWN_DAYS=7
MAX_LINKS_PER_PAGE=15

# === Dynamic Directory Domains (comma-separated) ===
# Add new directory targets here without changing code
DIRECTORY_DOMAINS=clutch.co,goodfirms.co,designrush.com,upcity.com,g2.com

# === Path Blocklist (comma-separated path segments to skip) ===
BLOCKLIST_PATTERNS=cdn-cgi,wp-json,wp-admin,wp-includes,feed,xmlrpc.php,privacy,terms,advertise,get-listed,press-releases,blog,cookies,legal,sitemap,careers,faq

# === Query Parameters to Strip (comma-separated) ===
IGNORED_QUERY_PARAMS=utm_,fbclid,gclid,sort_by,location,project_cost,filter_by_service,page,verified,rating,review_sort,search

# === DNS Servers for MX Verification (comma-separated) ===
DNS_SERVERS=8.8.8.8,1.1.1.1,9.9.9.9

# === Browser TLS Fingerprint Pool (comma-separated) ===
BROWSER_PROFILES=chrome120,chrome124,chrome126
